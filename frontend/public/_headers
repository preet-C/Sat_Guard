# =============================================================================
# Cloudflare Pages — Custom Response Headers
# =============================================================================

# ── Cross-Origin Isolation (required for SharedArrayBuffer) ──────────────────
# The conjunction worker pool uses SharedArrayBuffer for zero-copy ephemeris
# cache transfer. Without these headers, the app falls back to ArrayBuffer
# copies (~2x slower safe-slot search).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# ── Long-term cache for immutable assets ─────────────────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/cesiumStatic/*
  Cache-Control: public, max-age=31536000, immutable

/hero-sequence.mp4
  Cache-Control: public, max-age=31536000, immutable
