# =============================================================================
# SatGuard Frontend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it contains your Cesium token.

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local development (backend running on port 8000):
VITE_API_BASE=http://localhost:8000

# Production — replace with your actual Render.com URL after deployment:
# VITE_API_BASE=https://satguard-api.onrender.com

# ── CesiumJS Ion Token ────────────────────────────────────────────────────────
# Free token from: https://cesium.com/ion/tokens
VITE_CESIUM_TOKEN=your_cesium_ion_token_here
