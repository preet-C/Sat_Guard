# =============================================================================
# SatGuard Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Space-Track.org Credentials ──────────────────────────────────────────────
# Free account: https://www.space-track.org/auth/createAccount
SPACETRACK_USER=your@email.com
SPACETRACK_PASS=your_password

# ── Frontend Origin(s) for CORS ──────────────────────────────────────────────
# Comma-separated list. Include BOTH local dev and production domains.
FRONTEND_URL=http://localhost:5173,https://satguard.pages.dev

# ── Environment ──────────────────────────────────────────────────────────────
# "development" = shows /docs and /redoc
# "production"  = hides OpenAPI docs
ENVIRONMENT=development
